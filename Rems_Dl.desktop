#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Rems Dl
Comment=Multi-threaded image & media scraper with glass-morphism web UI
Exec=sh -c "cd /opt/rems-dl && python3 Rems_Dl.py"
Icon=/opt/rems-dl/icon/icon.png
StartupWMClass=Rems_Dl
Terminal=false
Categories=Graphics;Network;
StartupNotify=true
